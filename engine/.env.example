SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...
# โดเมนของหน้าเว็บที่อนุญาตให้เรียก API (คั่นด้วย , )
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
DEFAULT_TIME_LIMIT=60
MAX_TIME_LIMIT=600
SOLVER_WORKERS=4
